# ========== API ==========
API_HOST=0.0.0.0
API_PORT=8000

# ========== JWT/Security ==========
JWT_SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=30

# ========== Stripe ==========
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# ========== MercadoPago (Alternative) ==========
MERCADOPAGO_ACCESS_TOKEN=your_mercadopago_token_here

# ========== Database ==========
DATABASE_URL=sqlite:///./nike_bot.db
# Para producción: postgresql://user:password@localhost/nike_bot_db

# ========== Environment ==========
ENVIRONMENT=development
# development, staging, production
