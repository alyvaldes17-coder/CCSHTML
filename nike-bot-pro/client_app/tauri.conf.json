{
  "productName": "Nike Bot Commercial",
  "version": "1.0.0",
  "identifier": "com.prdes.nikebot",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "../dist",
    "features": ["custom-protocol"]
  },
  "app": {
    "windows": [
      {
        "title": "Nike Bot Commercial",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "portable"],
    "nsis": {
      "installerIcon": null,
      "installerHeaderIcon": null,
      "installerOutDir": "../dist",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
