{
  "manifest_version": 3,
  "name": "Nike Bot - Payment Helper",
  "version": "1.0",
  "description": "Automatiza el flujo de pago en Nike.cl",
  
  "permissions": [
    "tabs",
    "scripting",
    "webRequest",
    "webNavigation"
  ],
  
  "host_permissions": [
    "https://www.nike.cl/*",
    "https://checkout.vtex.com.br/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["https://www.nike.cl/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  
  "action": {
    "default_title": "Nike Bot"
  }
}
