# Nike Bot Pro - Environment Configuration
# Variables de entorno para el bot de Nike

# Configuración de Nike
NIKE_EMAIL=your_email@example.com
NIKE_PASSWORD=your_password
NIKE_PROFILE_PATH=./profiles

# Configuración de Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=False
PLAYWRIGHT_SLOWMO=0

# Configuración de Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/nike_bot.log

# Configuración de Proxy (opcional)
PROXY_URL=
USE_PROXY=False

# Configuración de Timeouts
LOGIN_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000
ELEMENT_TIMEOUT=5000

# Configuración de Debug
DEBUG_MODE=False
SAVE_SCREENSHOTS=False
SCREENSHOT_PATH=./screenshots

# Base de datos / Almacenamiento
ACCOUNTS_FILE=./accounts.json
COOKIES_FILE=./cookies_extracted.json

# Configuración de Threading
MAX_WORKERS=1
THREAD_TIMEOUT=300
